{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "interruption-tracker",
  "main": "backend/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": { "directory": "./frontend/public", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "interruption-tracker", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations" }]
}
