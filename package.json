{
  "name": "interruption-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "migrate:local": "wrangler d1 migrations apply interruption-tracker --local",
    "test": "node --test tests/*.test.js && python3 -m unittest discover -s tests -p 'test_*.py'",
    "check": "wrangler deploy --dry-run --outdir /tmp/interruption-tracker-build"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": { "node": ">=22.13" }
}
